{
  "extends": "$app/tsconfig",
  "compilerOptions": {
    "strict": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "types": ["node", "$app/types"]
  },
  "include": ["src", "tests", "*.ts"],
  "exclude": ["node_modules", "build"]
}
