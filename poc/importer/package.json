{
  "name": "@bali-driller/importer-poc",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm client && wrangler dev --env local --ip 127.0.0.1 --port 8787",
    "types": "wrangler types --strict-vars false --include-runtime false",
    "check": "tsc --noEmit && tsc --noEmit -p tsconfig.client.json",
    "test": "node --import tsx --test tests/*.test.ts",
    "build": "pnpm client && wrangler deploy --env=\"\" --dry-run --outdir .build",
    "deploy": "pnpm client && wrangler deploy --env=\"\"",
    "client": "esbuild client/app.ts --bundle --format=esm --outfile=public/app.js"
  },
  "dependencies": {
    "jose": "^6.2.12",
    "youtubei.js": "^18.1.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261015.1",
    "@types/node": "^22.20.5",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "wrangler": "^4.151.0"
  }
}
