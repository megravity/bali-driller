{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "bali-driller-importer-poc",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-16",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "vars": {
    "ACCESS_ISSUER": "https://flat-forest-eae8.cloudflareaccess.com",
    "ACCESS_AUD": "cb6bf66f5ce30eedaefbad2ff959075738330e8423a1e0835a1c58e6dc7aa4fc",
    "ALLOWED_EMAILS": "marvin.deutz@gmail.com",
    "LOCAL_DEV": "false"
  },
  "ratelimits": [
    {
      "name": "IMPORT_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 6,
        "period": 60
      }
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "env": {
    "local": {
      "vars": {
        "ACCESS_ISSUER": "",
        "ACCESS_AUD": "",
        "ALLOWED_EMAILS": "marvin.deutz@gmail.com",
        "LOCAL_DEV": "true"
      },
      "ratelimits": [
        {
          "name": "IMPORT_LIMITER",
          "namespace_id": "1001",
          "simple": {
            "limit": 6,
            "period": 60
          }
        }
      ]
    }
  },
  "account_id": "286dce4ff5b98eb697824d22c949ef1f",
  "routes": [
    {
      "pattern": "import.balisong.deu.tz",
      "custom_domain": true
    }
  ]
}
